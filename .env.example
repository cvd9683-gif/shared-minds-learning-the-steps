# Copy this file to .env and put your own token in it. Never commit .env.
# On a host like Render, set these in the dashboard instead — there is no .env there.

# Required for the dancer to take its own turn. Without it, teaching and
# replaying a phrase still work and the page says so.
# Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_put_your_token_here

# --- The stop switch -------------------------------------------------------
# Set to false / off / 0 to stop all new model calls. The page then reports the
# dancer as unavailable rather than letting people hit a wall. Read per request,
# so changing it and restarting takes effect immediately.
MODEL_CALLS_ENABLED=true

# --- How much anyone may use -----------------------------------------------
# Every one of these lives in memory and RESETS WHEN THE SERVICE RESTARTS.
# See "What the limits actually protect" in the README before trusting them.
MAX_CALLS_PER_VISITOR=8
VISITOR_WINDOW_MINUTES=60
MAX_CALLS_PER_HOUR=40
MAX_MODEL_CALLS=100
# Quiet time between one visitor's turns, in milliseconds.
TURN_COOLDOWN_MS=1500

# --- Networking ------------------------------------------------------------
# Locally the server binds 127.0.0.1 so nobody else on your network can spend
# your token. On Render, PORT and RENDER are set by the platform and the server
# binds 0.0.0.0 by itself — do not set either of these there.
PORT=3000
# HOST=0.0.0.0
